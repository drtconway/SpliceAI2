// Set here rather than in main.nf so that the trace file below can use it
params.outdir = "${projectDir}/outputs"

// Slurm settings, used only by the slurm profile. Leave slurm_account empty
// if the cluster has no accounts, and set slurm_setup to any shell commands
// a GPU job needs before running spliceai2-saturate (e.g. "module load cuda").
params.slurm_partition = 'GPU,GPU_SHORT,GPU-H100,gpu004,gpu005'
params.slurm_account = ''
params.slurm_gres = 'gpu:1'
params.slurm_queue_size = 16
params.slurm_setup = ''

profiles {
    // Default: one task at a time on the local machine, because a single
    // task saturates the GPU
    standard {
        process.executor = 'local'
        process.maxForks = 1
    }

    // One Slurm job per tile, each on its own GPU. The work folder must be
    // on a filesystem shared by the login and compute nodes, and on the same
    // filesystem as params.outdir so that published outputs can be hard links.
    slurm {
        process {
            executor = 'slurm'
            queue = params.slurm_partition
            clusterOptions = "--gres=${params.slurm_gres}" +
                (params.slurm_account ? " --account=${params.slurm_account}" : '')
            beforeScript = params.slurm_setup
            cpus = 4
            memory = { 128.GB * task.attempt }
            time = { 1.h * task.attempt }
        }
        executor {
            queueSize = params.slurm_queue_size
            submitRateLimit = '10/1min'
        }
    }
}

process {
    withName: SATURATE {
        errorStrategy = 'terminate'
    }
    withName: DELETIONS {
        errorStrategy = 'terminate'
    }
}


trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/trace.tsv"
}
